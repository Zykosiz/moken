# Godot editor caches and generated imports
.godot/
.mono/

# Local/editor configuration
.codex/
.mcp.json

# External asset and reference packs
Assets/*
!Assets/Kenney/
!Assets/Quaternius/
Reference/

# ...except the import settings and extracted material resources for those
# packs, which hold deliberate in-project decisions (extraction, normal maps,
# roughness/metallic) and should be tracked/rollback-able. Source models,
# textures, and everything else under these packs stays ignored.
Assets/Kenney/**
!Assets/Kenney/**/
!Assets/Kenney/**/*.import
!Assets/Kenney/**/*.tres

Assets/Quaternius/**
!Assets/Quaternius/**/
!Assets/Quaternius/**/*.import
!Assets/Quaternius/**/*.tres

# Build/export output (root-level only -- some asset packs have their own
# nested "Exports" folders that must stay subject to the Assets/ rules above)
/android/
/build/
/builds/
/exports/
/dist/
*.apk
*.aab
*.exe
*.pck
*.zip

# Godot export secrets/config
export.cfg
export_presets.cfg

# Python MCP server local state
python/venv/
python/.env
python/__pycache__/
python/tools/__pycache__/
__pycache__/
*.py[cod]

# Logs and temporary files
Logs/
logs/
*.log
*.tmp
*.temp

# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini

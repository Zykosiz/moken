[sub_resource type="Resource" id="Resource_6wfjy"]
script = ExtResource("1_byjj0")
speaker_name = "Old Fisher"
text = "Storms out past the reef again. Lighthouse keeper says it's been quiet too long."

[sub_resource type="Resource" id="Resource_76fq7"]
script = ExtResource("1_byjj0")
speaker_name = "Old Fisher"
text = "You're new around here, aren't you? Careful on the western cliffs after dark."

[sub_resource type="Resource" id="Resource_rhdj2"]
script = ExtResource("1_byjj0")
speaker_name = "Old Fisher"
text = "Anyway. Good tides to you."


[gd_resource type="Resource" script_class="DialogueSequence" format=3 uid="uid://farpmsbin1nv"]

[ext_resource type="Script" uid="uid://bsykum8g6nad" path="res://scripts/dialogue/DialogueLine.gd" id="1_line"]
[ext_resource type="Script" uid="uid://bu1gfy6c7178i" path="res://scripts/dialogue/DialogueSequence.gd" id="2_sequence"]

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("1_line")
speaker_name = "Vyla"
text = "Zako. Zako, wake up — it's happening today."

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("1_line")
speaker_name = "Zako"
text = "...What time is it."

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("1_line")
speaker_name = "Vyla"
text = "Late enough that if you don't get up, I'm telling Halvard you slept through your own promotion."

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("1_line")
speaker_name = "Zako"
text = "He'd probably just find that fitting."

[sub_resource type="Resource" id="Resource_5"]
script = ExtResource("1_line")
speaker_name = "Vyla"
text = "Get dressed. I'll be outside."

[resource]
script = ExtResource("2_sequence")
lines = Array[ExtResource("1_line")]([SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_4"), SubResource("Resource_5")])

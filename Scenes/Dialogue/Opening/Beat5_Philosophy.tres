[gd_resource type="Resource" script_class="DialogueSequence" format=3 uid="uid://c0cug17t8agbg"]

[ext_resource type="Script" uid="uid://bsykum8g6nad" path="res://scripts/dialogue/DialogueLine.gd" id="1_line"]
[ext_resource type="Script" uid="uid://bu1gfy6c7178i" path="res://scripts/dialogue/DialogueSequence.gd" id="2_sequence"]

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("1_line")
speaker_name = "Halvard"
text = "Sit. Before we get to the mechanical part, I want you to understand why this matters — because if you only ever see it as a job, you'll do it like one."

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("1_line")
speaker_name = "Zako"
text = "I'm listening."

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("1_line")
speaker_name = "Halvard"
text = "People out there — sailors, traders, whoever's lost their bearings in the dark — they don't see the island. Not at first. They see the light. It's the only thing telling them there's still a way home."

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("1_line")
speaker_name = "Halvard"
text = "You keep that light burning, and somewhere out there, someone stops being afraid. That's the whole job. Everything else is just upkeep."

[sub_resource type="Resource" id="Resource_5"]
script = ExtResource("1_line")
speaker_name = "Zako"
text = "That's... a lot more than I expected from an orientation."

[sub_resource type="Resource" id="Resource_6"]
script = ExtResource("1_line")
speaker_name = "Halvard"
text = "Get used to disappointment. Now — the oil reserves are kept—"

[resource]
script = ExtResource("2_sequence")
lines = Array[ExtResource("1_line")]([SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_4"), SubResource("Resource_5"), SubResource("Resource_6")])

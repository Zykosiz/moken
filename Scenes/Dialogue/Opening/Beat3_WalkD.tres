[gd_resource type="Resource" script_class="DialogueSequence" format=3 uid="uid://f3mdwqcjbhub"]

[ext_resource type="Script" uid="uid://bsykum8g6nad" path="res://scripts/dialogue/DialogueLine.gd" id="1_line"]
[ext_resource type="Script" uid="uid://bu1gfy6c7178i" path="res://scripts/dialogue/DialogueSequence.gd" id="2_sequence"]

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("1_line")
speaker_name = "Vyla"
text = "Anyway — don't let Halvard scare you. He's all bark. Mostly."

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("1_line")
speaker_name = "Zako"
text = "\"Mostly\" is doing a lot of work in that sentence."

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("1_line")
speaker_name = "Vyla"
text = "You'll survive. Probably."

[resource]
script = ExtResource("2_sequence")
lines = Array[ExtResource("1_line")]([SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3")])
